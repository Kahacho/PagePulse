{
	"manifest_version": 3,
	"name": "PagePulse",
	"version": "1.0.0",
	"description": "Auto-refresh any page on a schedule, or watch for a keyword and stop the moment it appears. Works per-page, with light and dark themes.",
	"permissions": [
		"tabs",
		"activeTab",
		"scripting",
		"notifications",
		"storage",
		"offscreen"
	],
	"host_permissions": ["<all_urls>"],
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Ctrl+Shift+1", "mac": "Command+Shift+1" },
			"description": "Open the PagePulse popup"
		},
		"toggle-reload": {
			"suggested_key": { "default": "Ctrl+Shift+2", "mac": "Command+Shift+2" },
			"description": "Start or stop PagePulse on the current page"
		}
	},
	"background": {
		"service_worker": "background.js"
	},
	"action": {
		"default_popup": "index.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"24": "icons/icon24.png",
		"32": "icons/icon32.png",
		"64": "icons/icon64.png",
		"128": "icons/icon128.png"
	}
}
